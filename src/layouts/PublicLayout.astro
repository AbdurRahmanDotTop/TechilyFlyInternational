---
import Layout from './Layout.astro';
---
<Layout>
    <div class="min-h-screen flex flex-col">
      <header class="border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16 items-center">
            <div class="flex-shrink-0">
              <a href="/" class="text-2xl font-bold tracking-tight">
                <span class="text-primary">Techily Fly</span>
                <span class="text-foreground ml-1">International</span>
              </a>
            </div>
            <nav class="hidden md:flex space-x-8 items-center">
              <a href="/" class="text-foreground/80 hover:text-primary font-medium transition-colors">
                Find Jobs
              </a>
              {Astro.locals.user ? (
                <>
                  <a href={`/${Astro.locals.user.role.toLowerCase()}`} class="text-foreground/80 hover:text-primary font-medium transition-colors">
                    Dashboard
                  </a>
                  <form action="/api/auth/logout" method="POST" class="inline">
                    <button type="submit" class="bg-secondary text-secondary-foreground hover:bg-secondary/80 px-4 py-2 rounded-md font-medium transition-colors">
                      Logout
                    </button>
                  </form>
                </>
              ) : (
                <>
                  <a href="/login" class="text-foreground/80 hover:text-primary font-medium transition-colors">
                    Sign In
                  </a>
                  <a href="/employer" class="bg-primary text-primary-foreground hover:bg-primary/90 px-4 py-2 rounded-md font-medium transition-colors shadow-sm">
                    Employer Portal
                  </a>
                </>
              )}
            </nav>
            {/* Mobile menu button (Simplified MVP) */}
            <div class="md:hidden flex items-center">
              <button class="text-foreground p-2">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
              </button>
            </div>
          </div>
        </div>
      </header>

      <main class="flex-1 bg-background">
        <slot />
      </main>

      <footer class="bg-foreground text-white border-t border-white/10 relative overflow-hidden">
        {/* Subtle top gradient glow using brand colors */}
        <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"></div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-[500px] bg-primary/5 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 relative z-10">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16">
            
            {/* Brand Section */}
            <div class="md:col-span-5 lg:col-span-4">
              <a href="/" class="inline-block text-3xl font-extrabold tracking-tight mb-6 hover:opacity-80 transition-opacity">
                <span class="text-primary">Techily Fly</span>
                <span class="text-white ml-1">International</span>
              </a>
              <p class="text-muted-foreground/80 leading-relaxed mb-8 max-w-sm">
                Serious technology. Intelligent systems. Human energy. We bridge the gap between world-class talent and visionary employers across the Gulf region.
              </p>
              
              <div class="flex items-center space-x-4">
                {/* Social Placeholders */}
                <a href="#" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white/70 hover:bg-primary hover:text-white transition-all hover:scale-110">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
                </a>
                <a href="#" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white/70 hover:bg-primary hover:text-white transition-all hover:scale-110">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </a>
              </div>
            </div>

            {/* Quick Links */}
            <div class="md:col-span-3 lg:col-span-2 lg:col-start-6">
              <h4 class="text-white font-bold mb-6 tracking-wide">Platform</h4>
              <ul class="space-y-4">
                <li><a href="/" class="text-muted-foreground/80 hover:text-primary transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-primary/0 group-hover:bg-primary transition-colors"></span>Find Jobs</a></li>
                <li><a href="/employer" class="text-muted-foreground/80 hover:text-primary transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-primary/0 group-hover:bg-primary transition-colors"></span>Employer Portal</a></li>
                <li><a href="/candidate" class="text-muted-foreground/80 hover:text-primary transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-primary/0 group-hover:bg-primary transition-colors"></span>Candidate Dashboard</a></li>
                <li><a href="https://international.techilyfly.com/" class="text-muted-foreground/80 hover:text-primary transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-primary/0 group-hover:bg-primary transition-colors"></span>Main Website &rarr;</a></li>
              </ul>
            </div>

            {/* Legal */}
            <div class="md:col-span-2 lg:col-span-2">
              <h4 class="text-white font-bold mb-6 tracking-wide">Legal</h4>
              <ul class="space-y-4">
                <li><a href="#" class="text-muted-foreground/80 hover:text-primary transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-primary/0 group-hover:bg-primary transition-colors"></span>Privacy Policy</a></li>
                <li><a href="#" class="text-muted-foreground/80 hover:text-primary transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-primary/0 group-hover:bg-primary transition-colors"></span>Terms of Service</a></li>
                <li><a href="#" class="text-muted-foreground/80 hover:text-primary transition-colors flex items-center gap-2 group"><span class="w-1.5 h-1.5 rounded-full bg-primary/0 group-hover:bg-primary transition-colors"></span>Cookie Policy</a></li>
              </ul>
            </div>

            {/* Contact */}
            <div class="md:col-span-4 lg:col-span-3">
              <h4 class="text-white font-bold mb-6 tracking-wide">Contact</h4>
              <ul class="space-y-4 text-muted-foreground/80">
                <li>
                  <a href="mailto:International.TechilyFly@gmail.com" class="hover:text-primary transition-colors flex items-center gap-3 group">
                    <div class="w-8 h-8 rounded-md bg-white/5 flex items-center justify-center group-hover:bg-primary/20 group-hover:text-primary transition-colors shrink-0">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    </div>
                    <span class="truncate">International.TechilyFly@gmail.com</span>
                  </a>
                </li>
                <li>
                  <a href="https://wa.me/918825164657" class="hover:text-primary transition-colors flex items-center gap-3 group">
                    <div class="w-8 h-8 rounded-md bg-white/5 flex items-center justify-center group-hover:bg-primary/20 group-hover:text-primary transition-colors shrink-0">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                    </div>
                    <span>+91 8825164657 (WhatsApp)</span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
          
          <div class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-muted-foreground/60 text-sm">
              &copy; {new Date().getFullYear()} Techily Fly International. All rights reserved.
            </p>
            <div class="text-muted-foreground/60 text-sm flex items-center gap-2">
              <span>Engineered with</span>
              <span class="text-primary animate-pulse">❤️</span>
              <span>for the Gulf</span>
            </div>
          </div>
        </div>
      </footer>
    </div>
</Layout>
