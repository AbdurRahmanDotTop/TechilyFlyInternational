---
import Layout from './Layout.astro';
---
<Layout>
    <div class="flex min-h-screen">
      <aside class="w-64 bg-slate-900 text-white p-6">
        <h2 class="text-xl font-bold mb-6">Admin Panel</h2>
        <nav class="space-y-2">
          <a href="/admin" class="block px-4 py-2 rounded bg-slate-800">Dashboard</a>
          <a href="/admin/jobs" class="block px-4 py-2 rounded hover:bg-slate-800">Jobs Queue</a>
          <a href="/admin/users" class="block px-4 py-2 rounded hover:bg-slate-800">Users</a>
        </nav>
      </aside>
      <main class="flex-1 p-8 bg-slate-50">
        <slot />
      </main>
    </div>
</Layout>
