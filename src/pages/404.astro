---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="404 - Page Not Found">
  <div class="min-h-[70vh] flex items-center justify-center bg-background px-4">
    <div class="max-w-xl w-full text-center space-y-8 p-10 bg-white rounded-2xl shadow-sm border border-border">
      <div class="space-y-4">
        <h1 class="text-7xl font-extrabold text-foreground tracking-tighter">404</h1>
        <h2 class="text-3xl font-bold text-foreground">Page Not Found</h2>
        <p class="text-muted-foreground text-lg max-w-md mx-auto leading-relaxed">
          Sorry, the page you’re looking for doesn’t exist or may have been moved.
        </p>
      </div>
      
      <div class="pt-4">
        <a 
          href="/" 
          class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-primary-foreground bg-primary hover:bg-primary/90 rounded-lg transition-colors duration-200"
        >
          Back to Home
        </a>
      </div>
    </div>
  </div>
</PublicLayout>
