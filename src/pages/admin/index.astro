---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
import { users, jobs, applications } from '../../lib/db/schema';
import { env } from 'cloudflare:workers';
import { sql, eq } from 'drizzle-orm';

const db = getDb(env);

// Fetch stats using count
const totalUsersRes = await db.select({ count: sql<number>`count(*)` }).from(users);
const totalJobsRes = await db.select({ count: sql<number>`count(*)` }).from(jobs);
const totalAppsRes = await db.select({ count: sql<number>`count(*)` }).from(applications);

const activeJobsRes = await db.select({ count: sql<number>`count(*)` }).from(jobs).where(eq(jobs.status, 'PUBLISHED'));
const pendingJobsRes = await db.select({ count: sql<number>`count(*)` }).from(jobs).where(eq(jobs.status, 'DRAFT'));

const stats = {
  users: totalUsersRes[0]?.count || 0,
  jobs: totalJobsRes[0]?.count || 0,
  applications: totalAppsRes[0]?.count || 0,
  activeJobs: activeJobsRes[0]?.count || 0,
  pendingJobs: pendingJobsRes[0]?.count || 0,
};
---
<AdminLayout>
    <div>
      <div class="mb-8">
        <h1 class="text-3xl font-bold mb-2">Admin Dashboard</h1>
        <p class="text-muted-foreground">Overview and statistics for the platform.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Users Stat -->
        <div class="bg-card border rounded-xl p-6 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-medium text-muted-foreground uppercase tracking-wider">Total Users</h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/70 h-5 w-5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <p class="text-4xl font-bold mt-4 text-foreground">{stats.users}</p>
        </div>

        <!-- Total Jobs Stat -->
        <div class="bg-card border rounded-xl p-6 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-medium text-muted-foreground uppercase tracking-wider">Total Jobs</h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/70 h-5 w-5"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <p class="text-4xl font-bold mt-4 text-foreground">{stats.jobs}</p>
        </div>

        <!-- Active Jobs Stat -->
        <div class="bg-card border rounded-xl p-6 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-medium text-muted-foreground uppercase tracking-wider">Active Jobs</h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600/70 h-5 w-5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <p class="text-4xl font-bold mt-4 text-green-600">{stats.activeJobs}</p>
        </div>

        <!-- Pending Jobs Stat -->
        <div class="bg-card border rounded-xl p-6 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-medium text-muted-foreground uppercase tracking-wider">Pending Jobs</h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500/70 h-5 w-5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <p class="text-4xl font-bold mt-4 text-orange-500">{stats.pendingJobs}</p>
        </div>

        <!-- Applications Stat -->
        <div class="bg-card border rounded-xl p-6 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-medium text-muted-foreground uppercase tracking-wider">Applications</h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500/70 h-5 w-5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <p class="text-4xl font-bold mt-4 text-blue-600">{stats.applications}</p>
        </div>
      </div>
    </div>
</AdminLayout>
